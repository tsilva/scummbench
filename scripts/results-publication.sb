(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "NODE")))
(deny network*)
(allow network-outbound (remote tcp "localhost:8283"))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny file-read-data (subpath (param "USER_HOME")))
(allow file-read-data
  (literal (param "NODE")) (literal (param "CA"))
  (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt")
  (literal (string-append (param "REPOSITORY") "/package.json"))
  (subpath (string-append (param "REPOSITORY") "/src"))
  (subpath (string-append (param "REPOSITORY") "/web"))
  (literal (string-append (param "REPOSITORY") "/scripts/results-upload.js"))
  (literal (string-append (param "REPOSITORY") "/local/results-publication.json"))
  (subpath (string-append (param "REPOSITORY") "/.internal/publication")))
(deny file-write*)
(allow file-write* (literal "/dev/null")
  (subpath (string-append (param "REPOSITORY") "/.internal/publication")))
