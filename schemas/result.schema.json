{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScummBench development result v1",
  "type": "object",
  "required": ["schema_version", "run_id", "suite", "task_id", "task_sha256", "game", "track", "category", "session_id", "official_eligible", "eligibility_reasons", "started_at", "finished_at", "elapsed_ms", "agent", "scummbench", "backend", "budgets", "usage", "model_usage", "status", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "suite": { "type": "string", "minLength": 1 },
    "game": { "const": "flight-of-the-amazon-queen" },
    "track": { "const": "closed-book" },
    "category": { "const": "short-task" },
    "official_eligible": { "const": false },
    "eligibility_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["success", "failure", "budget_exhausted", "invalid_agent", "infrastructure_error"] },
    "reason": { "type": "string", "minLength": 1 },
    "agent": { "type": "object", "required": ["label", "config_sha256", "provenance", "model", "seed"] },
    "scummbench": { "type": "object", "required": ["commit_id", "dirty"] },
    "backend": { "type": "object", "required": ["commit_id"] },
    "budgets": { "type": "object" },
    "usage": { "type": "object", "required": ["decisions", "submitted_actions", "action_sequences", "observations", "requested_wait_ticks", "requested_wait_ms"], "properties": {
      "decisions": { "type": "integer", "minimum": 0 },
      "submitted_actions": { "type": "integer", "minimum": 0 },
      "action_sequences": { "type": "integer", "minimum": 0 },
      "observations": { "type": "integer", "minimum": 0 },
      "requested_wait_ticks": { "type": "integer", "minimum": 0 },
      "requested_wait_ms": { "type": "integer", "minimum": 0 }
    } },
    "model_usage": { "type": "object", "required": ["input_tokens", "cached_input_tokens", "output_tokens", "api_equivalent_usd", "reason"] }
  }
}
